{
  "about": "Shared synchronization fixtures (docs/SYNC_SPEC.md). Expected values were derived by hand from the spec. Run by tests/sync.test.mjs (browser) and mobile/test/sync_test.dart (Android). cue = [lineIndex, startMs, endMs, synced]. query = [tMs, expectedLineIndexOrNull].",
  "constants": { "MAX_AUTO_HOLD_MS": 8000, "PROVISIONAL_SPACING_MS": 3500 },
  "resolve": [
    { "name": "song starts immediately with vocals", "durationMs": 10000, "vocalStartMs": null,
      "lines": [["Hello", 0, null], ["World", 2500, null], ["Again", 5000, null]],
      "cues": [[0, 0, 2500, true], [1, 2500, 5000, true], [2, 5000, 10000, true]], "unplaced": [],
      "queries": [[0, 0], [2499, 0], [2500, 1], [9999, 2], [10000, null]] },
    { "name": "short instrumental intro", "durationMs": 60000, "vocalStartMs": 4000,
      "lines": [["One", 4000, null], ["Two", 7000, null], ["Three", 10000, null]],
      "cues": [[0, 4000, 7000, true], [1, 7000, 10000, true], [2, 10000, 18000, true]], "unplaced": [],
      "queries": [[0, null], [3999, null], [4000, 0], [17999, 2], [18000, null]] },
    { "name": "long instrumental intro", "durationMs": 200000, "vocalStartMs": 45000,
      "lines": [["Finally", 45000, null], ["Singing", 49000, null]],
      "cues": [[0, 45000, 49000, true], [1, 49000, 57000, true]], "unplaced": [],
      "queries": [[0, null], [30000, null], [44999, null], [45000, 0], [56999, 1], [57000, null]] },
    { "name": "instrumental break between vocal sections", "durationMs": 200000, "vocalStartMs": 15000,
      "lines": [["Verse a", 15000, 18000], ["Verse b", 19000, 22000], ["Chorus a", 60000, null], ["Chorus b", 63000, 70000]],
      "cues": [[0, 15000, 18000, true], [1, 19000, 22000, true], [2, 60000, 63000, true], [3, 63000, 70000, true]], "unplaced": [],
      "queries": [[18500, null], [30000, null], [59999, null], [60000, 2], [69999, 3], [70000, null]] },
    { "name": "line without explicit end is held at most 8 s", "durationMs": 100000, "vocalStartMs": null,
      "lines": [["A", 10000, null], ["B", 40000, null]],
      "cues": [[0, 10000, 18000, true], [1, 40000, 48000, true]], "unplaced": [],
      "queries": [[17999, 0], [18000, null], [20000, null], [40000, 1]] },
    { "name": "final lyric is held until the song ends", "durationMs": 100000, "vocalStartMs": null,
      "lines": [["A", 10000, null], ["Last", 95000, null]],
      "cues": [[0, 10000, 18000, true], [1, 95000, 100000, true]], "unplaced": [],
      "queries": [[99999, 1], [100000, null]] },
    { "name": "final lyric explicit end is respected", "durationMs": 60000, "vocalStartMs": null,
      "lines": [["Long note", 5000, 30000]],
      "cues": [[0, 5000, 30000, true]], "unplaced": [],
      "queries": [[29000, 0], [29999, 0], [30000, null]] },
    { "name": "zero is a real timestamp", "durationMs": null, "vocalStartMs": null,
      "lines": [["Now", 0, null], ["Next", 3000, null]],
      "cues": [[0, 0, 3000, true], [1, 3000, 11000, true]], "unplaced": [],
      "queries": [[0, 0], [3000, 1]] },
    { "name": "no timing and no vocal start shows nothing", "durationMs": 60000, "vocalStartMs": null,
      "lines": [["A", null, null], ["B", null, null], ["C", null, null]],
      "cues": [], "unplaced": [0, 1, 2],
      "queries": [[0, null], [5000, null]] },
    { "name": "no timing but vocal start known spreads from vocal start", "durationMs": 60000, "vocalStartMs": 15000,
      "lines": [["A", null, null], ["B", null, null], ["C", null, null]],
      "cues": [[0, 15000, 18500, false], [1, 18500, 22000, false], [2, 22000, 30000, false]], "unplaced": [],
      "queries": [[0, null], [14999, null], [15000, 0], [18500, 1], [29999, 2], [30000, null]] },
    { "name": "first line synced, later lines provisional", "durationMs": 60000, "vocalStartMs": 15000,
      "lines": [["A", 15000, null], ["B", null, null], ["C", null, null]],
      "cues": [[0, 15000, 18500, true], [1, 18500, 22000, false], [2, 22000, 30000, false]], "unplaced": [],
      "queries": [[14999, null], [15000, 0]] },
    { "name": "unsynced lines interpolate between synced anchors", "durationMs": null, "vocalStartMs": null,
      "lines": [["A", 10000, null], ["B", null, null], ["C", null, null], ["D", 22000, null]],
      "cues": [[0, 10000, 14000, true], [1, 14000, 18000, false], [2, 18000, 22000, false], [3, 22000, 30000, true]], "unplaced": [],
      "queries": [[13999, 0], [14000, 1], [22000, 3]] },
    { "name": "leading unsynced lines start at vocal start", "durationMs": null, "vocalStartMs": 8000,
      "lines": [["A", null, null], ["B", null, null], ["C", 14000, null]],
      "cues": [[0, 8000, 11000, false], [1, 11000, 14000, false], [2, 14000, 22000, true]], "unplaced": [],
      "queries": [[7999, null], [8000, 0]] },
    { "name": "leading unsynced lines without vocal start are not shown", "durationMs": null, "vocalStartMs": null,
      "lines": [["A", null, null], ["B", 12000, null]],
      "cues": [[1, 12000, 20000, true]], "unplaced": [0],
      "queries": [[0, null], [11999, null], [12000, 1]] },
    { "name": "empty lines are ignored and never anchor", "durationMs": null, "vocalStartMs": null,
      "lines": [["", 0, null], ["   ", null, null], ["Real", 5000, null]],
      "cues": [[2, 5000, 13000, true]], "unplaced": [],
      "queries": [[0, null], [5000, 2]] },
    { "name": "lines at or after the song end are unplaced", "durationMs": 60000, "vocalStartMs": null,
      "lines": [["A", 5000, null], ["Too late", 65000, null]],
      "cues": [[0, 5000, 13000, true]], "unplaced": [1],
      "queries": [[5000, 0]] },
    { "name": "explicit end is clipped by the next line", "durationMs": null, "vocalStartMs": null,
      "lines": [["A", 5000, 9000], ["B", 7000, null]],
      "cues": [[0, 5000, 7000, true], [1, 7000, 15000, true]], "unplaced": [],
      "queries": [[6999, 0], [7000, 1]] },
    { "name": "out-of-order times are shown in time order", "durationMs": null, "vocalStartMs": null,
      "lines": [["Later", 9000, null], ["Earlier", 3000, null]],
      "cues": [[1, 3000, 9000, true], [0, 9000, 17000, true]], "unplaced": [],
      "queries": [[3000, 1], [9000, 0]] },
    { "name": "end not after start is ignored", "durationMs": null, "vocalStartMs": null,
      "lines": [["A", 5000, 5000], ["B", 9000, null]],
      "cues": [[0, 5000, 9000, true], [1, 9000, 17000, true]], "unplaced": [],
      "queries": [[8999, 0]] },
    { "name": "backing vocal on the same timestamp: later line wins", "durationMs": null, "vocalStartMs": null,
      "lines": [["Lead", 5000, null], ["(ooh)", 5000, null], ["Next", 8000, null]],
      "cues": [[0, 5000, 5000, true], [1, 5000, 8000, true], [2, 8000, 16000, true]], "unplaced": [],
      "queries": [[5000, 1], [7999, 1]] },
    { "name": "explicit early line beats vocal start", "durationMs": null, "vocalStartMs": 20000,
      "lines": [["A", 10000, null]],
      "cues": [[0, 10000, 18000, true]], "unplaced": [],
      "queries": [[10000, 0]] },
    { "name": "provisional lines past the end are unplaced", "durationMs": 58000, "vocalStartMs": null,
      "lines": [["A", 50000, null], ["B", null, null], ["C", null, null], ["D", null, null]],
      "cues": [[0, 50000, 53500, true], [1, 53500, 57000, false], [2, 57000, 58000, false]], "unplaced": [3],
      "queries": [[57999, 2], [58000, null]] }
  ],
  "migrateAndroidV1": [
    { "name": "zero means never synced in v1", "lines": [["a", 0], ["b", 4200], ["c", 0]], "expectStartMs": [null, 4200, null] }
  ],
  "migrateWebV1": [
    { "name": "seconds become milliseconds", "lyrics": [["a", 1.234, 3.5], ["b", 0, 2]], "expect": [[1234, 3500], [0, 2000]] }
  ],
  "parse": [
    { "name": "LRC with tags, repeated stamps and an untimed line", "text": "[ti:Song]\n[00:12.50]First\n[00:15.20][01:02.00]Chorus\nplain words",
      "expect": [["First", 12500, null], ["Chorus", 15200, null], ["Chorus", 62000, null], ["plain words", null, null]] },
    { "name": "LRC all timed is sorted by time", "text": "[00:20.00]B\n[00:10.00]A",
      "expect": [["A", 10000, null], ["B", 20000, null]] },
    { "name": "LRC zero stamp", "text": "[00:00.00]Starts now", "expect": [["Starts now", 0, null]] },
    { "name": "LRC millisecond stamp", "text": "[01:05.123]B", "expect": [["B", 65123, null]] },
    { "name": "LRC offset tag", "text": "[offset:+500]\n[00:10.00]A", "expect": [["A", 9500, null]] },
    { "name": "SRT keeps start and end", "text": "1\n00:00:15,200 --> 00:00:18,950\nHello\nthere\n\n2\n00:01:00,000 --> 00:01:03,000\nNext",
      "expect": [["Hello there", 15200, 18950], ["Next", 60000, 63000]] },
    { "name": "plain text is unsynced, never spread", "text": "line one\n\nline two", "expect": [["line one", null, null], ["line two", null, null]] }
  ]
}
